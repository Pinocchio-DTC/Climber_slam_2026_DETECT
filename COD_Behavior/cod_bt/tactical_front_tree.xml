<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Main_tree">
  <BehaviorTree ID="Main_tree">
    <KeepRunningUntilFailure>
      <ReactiveFallback>
        <Inverter>
          <WriteToBlackboard Hp="{hp}"
                             Remaining_rounds="{remaining_rounds}"
                             Our_base_hp="{our_base_hp}"
                             Sentry_mode="{sentry_mode}"
                             Sentry_buff="{sentry_buff}"
                             Match_time="{match_time}"/>
        </Inverter>

        <ReactiveSequence>
          <Fallback>
            <HpCondition Hp="{hp}"
                         threshold="250"/>
            <RemainingRoundsBelowCondition Remaining_rounds="{remaining_rounds}"
                                          threshold="50"/>
          </Fallback>
          <Fallback>
            <Sequence>
              <BoolEqualsCondition value="{on_left_leg}"
                                   expected="true"/>
              <SetSentryMode mode="move"
                             mode_topic="{zone_mode_topic}"/>
              <AnnounceBehavior label="左路巡逻撤退，执行rmuc1_left_back"/>
              <NavigateThroughPosesAction waypoint_file="/home/nucshao/Climber_slam_2026_NAV/src/rm_bringup/wps/rmuc1_left_back.csv"
                                          frame_id="map"
                                          current_waypoint="{back_current_waypoint}"/>
              <StayHome Hp="{hp}"/>
            </Sequence>
            <Sequence>
              <BoolEqualsCondition value="{on_right_leg}"
                                   expected="true"/>
              <SetSentryMode mode="move"
                             mode_topic="{zone_mode_topic}"/>
              <AnnounceBehavior label="右路巡逻撤退，执行rmuc1_right_back"/>
              <NavigateThroughPosesAction waypoint_file="/home/nucshao/Climber_slam_2026_NAV/src/rm_bringup/wps/rmuc1_right_back.csv"
                                          frame_id="map"
                                          current_waypoint="{back_current_waypoint}"/>
              <StayHome Hp="{hp}"/>
            </Sequence>
            <Sequence>
              <SetSentryMode mode="move"
                             mode_topic="{zone_mode_topic}"/>
              <AnnounceBehavior label="非巡逻中触发撤退，执行rmuc1_left_back"/>
              <NavigateThroughPosesAction waypoint_file="/home/nucshao/Climber_slam_2026_NAV/src/rm_bringup/wps/rmuc1_left_back.csv"
                                          frame_id="map"
                                          current_waypoint="{back_current_waypoint}"/>
              <StayHome Hp="{hp}"/>
            </Sequence>
          </Fallback>
        </ReactiveSequence>

        <ReactiveSequence>
          <HpAboveCondition Hp="{hp}"
                            threshold="250"/>
          <BoolEqualsCondition value="{front_test_done}"
                               expected="false"/>
          <Sequence>
            <SetSentryMode mode="move"
                           mode_topic="{zone_mode_topic}"/>
            <AnnounceBehavior label="高血执行test路线"/>
            <NavigateThroughPosesAction waypoint_file="/home/nucshao/Climber_slam_2026_NAV/src/rm_bringup/wps/rmuc1_push.csv"
                                        frame_id="map"
                                        current_waypoint="{front_current_waypoint}"/>
            <SetSentryMode mode="attack"
                           mode_topic="{zone_mode_topic}"/>
            <AnnounceBehavior label="test路线完成，切换进攻姿态"/>
            <SetBool value="true"
                     target="{front_test_done}"/>
          </Sequence>
        </ReactiveSequence>

        <ReactiveSequence>
          <HpAboveCondition Hp="{hp}"
                            threshold="250"/>
          <BoolEqualsCondition value="{front_test_done}"
                               expected="true"/>
          <MatchTimeAboveCondition Match_time="{match_time}"
                                   threshold="180"/>
          <WaitDuration duration_sec="0.5"/>
        </ReactiveSequence>

        <ReactiveSequence>
          <HpAboveCondition Hp="{hp}"
                            threshold="250"/>
          <BoolEqualsCondition value="{front_test_done}"
                               expected="true"/>
          <Inverter>
            <MatchTimeAboveCondition Match_time="{match_time}"
                                     threshold="400"/>
          </Inverter>
          <SetSentryMode mode="attack"
                         mode_topic="{zone_mode_topic}"/>
          <AnnounceBehavior label="test路线完成，循环执行rmuc1_right-rmuc1_left"/>
          <KeepRunningUntilFailure>
            <Sequence>
              <SetBool value="false"
                       target="{on_left_leg}"/>
              <SetBool value="true"
                       target="{on_right_leg}"/>
              <NavigateThroughPosesAction waypoint_file="/home/nucshao/Climber_slam_2026_NAV/src/rm_bringup/wps/rmuc1_right.csv"
                                          frame_id="map"
                                          current_waypoint="{patrol_current_waypoint}"/>
              <WaitDuration duration_sec="10"/>
              <SetBool value="false"
                       target="{on_right_leg}"/>
              <SetBool value="true"
                       target="{on_left_leg}"/>
              <NavigateThroughPosesAction waypoint_file="/home/nucshao/Climber_slam_2026_NAV/src/rm_bringup/wps/rmuc1_left.csv"
                                          frame_id="map"
                                          current_waypoint="{patrol_current_waypoint}"/>
              <WaitDuration duration_sec="10"/>
            </Sequence>
          </KeepRunningUntilFailure>
        </ReactiveSequence>
      </ReactiveFallback>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="GetCurrentWaypoint"
            editable="true">
      <input_port name="waypoints"/>
      <input_port name="wait_times"/>
      <input_port name="wp_idx"/>
      <output_port name="current_goal"/>
      <output_port name="current_wait_sec"/>
    </Action>
    <Condition ID="HpCondition"
               editable="true">
      <input_port name="Hp"/>
      <input_port name="threshold"/>
    </Condition>
    <Condition ID="HpAboveCondition"
               editable="true">
      <input_port name="Hp"/>
      <input_port name="threshold"/>
    </Condition>
    <Condition ID="StayHome"
               editable="true">
      <input_port name="Hp"/>
    </Condition>
    <Condition ID="BoolEqualsCondition"
               editable="true">
      <input_port name="value"/>
      <input_port name="expected"/>
    </Condition>
    <Condition ID="MatchTimeAboveCondition"
               editable="true">
      <input_port name="Match_time"/>
      <input_port name="threshold"/>
    </Condition>
    <Condition ID="RemainingRoundsBelowCondition"
               editable="true">
      <input_port name="Remaining_rounds"/>
      <input_port name="threshold"/>
    </Condition>
    <Condition ID="BaseHpBelowCondition"
               editable="true">
      <input_port name="Our_base_hp"/>
      <input_port name="threshold"/>
    </Condition>
    <Action ID="LoadWaypoints"
            editable="true">
      <input_port name="waypoint_file"/>
      <input_port name="frame_id"/>
      <output_port name="waypoints"/>
      <output_port name="wait_times"/>
      <output_port name="total_waypoints"/>
      <output_port name="wp_idx"/>
    </Action>
    <Action ID="NextWaypoint"
            editable="true">
      <inout_port name="wp_idx"/>
      <input_port name="total_waypoints"/>
    </Action>
    <Action ID="NextWaypointUntilDone"
            editable="true">
      <inout_port name="wp_idx"/>
      <input_port name="total_waypoints"/>
    </Action>
    <Action ID="PubNav2Goal"
            editable="true">
      <input_port name="goal_pose"/>
      <input_port name="frame_id"/>
      <input_port name="min_pub_interval_ms"/>
    </Action>
    <Action ID="AnnounceBehavior"
            editable="true">
      <input_port name="label"/>
    </Action>
    <Action ID="SetBool"
            editable="true">
      <input_port name="value"/>
      <output_port name="target"/>
    </Action>
    <Action ID="FollowWaypointsAction"
            editable="true">
      <input_port name="waypoint_file"/>
      <input_port name="frame_id"/>
    </Action>
    <Action ID="NavigateThroughPosesAction"
            editable="true">
      <input_port name="waypoint_file"/>
      <input_port name="frame_id"/>
      <output_port name="current_waypoint"/>
    </Action>
    <Action ID="SetSentryMode"
            editable="true">
      <input_port name="mode"/>
      <input_port name="mode_topic"/>
      <input_port name="enable_auto_fallback"/>
      <input_port name="republish_interval_ms"/>
    </Action>
    <Action ID="WaitDuration"
            editable="true">
      <input_port name="duration_sec"/>
    </Action>
    <Action ID="WaitUntilReached"
            editable="true">
      <input_port name="goal_pose"/>
      <input_port name="tolerance"/>
    </Action>
    <Action ID="WriteToBlackboard"
            editable="true">
      <output_port name="Hp"/>
      <output_port name="Remaining_rounds"/>
      <output_port name="Our_base_hp"/>
      <output_port name="Sentry_mode"/>
      <output_port name="Sentry_buff"/>
      <output_port name="Match_time"/>
    </Action>
  </TreeNodesModel>
</root>
